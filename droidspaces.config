# Droidspaces 配置片段 —— 最小化版 (排查开机问题用)
#
# 背景: 全量片段 (见 droidspaces-full.config) 刷入后手机卡在"正在启动"。
# 全量版里 CONFIG_SYSVIPC / CONFIG_DEVTMPFS / CONFIG_FAIR_GROUP_SCHED
# 三星原厂是关闭的, 重新开启可能与预编译 vendor 模块/ueventd 冲突。
#
# 本最小化版只包含**不改 task_struct 布局**、风险最低的必需项:
#   - PID_NS / IPC_NS / USER_NS: Droidspaces 容器核心 (原厂全关)
#   - POSIX_MQUEUE: systemd 需要 (原厂关)
# 若此版本能开机, 再逐个加回: SYSVIPC -> DEVTMPFS -> FAIR_GROUP_SCHED -> 其余

# Core namespace support
CONFIG_PID_NS=y
CONFIG_IPC_NS=y

# Fix for docker unsafe procfs error
CONFIG_USER_NS=y

# IPC mechanisms (systemd)
CONFIG_POSIX_MQUEUE=y
