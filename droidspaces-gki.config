# DroidSpaces GKI-exclusive core configuration.
# Keep this list aligned with the upstream DroidSpaces GKI guide. Do not add
# the legacy/non-GKI configuration block here without a separate ABI review.

CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_DEVTMPFS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# Upstream marks USER_NS optional but recommended for container runtimes.
CONFIG_USER_NS=y
